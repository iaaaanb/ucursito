# Credenciales de U-Cursos
# Copia este archivo a .env y completa tus datos. NUNCA commitees el .env.

UCURSOS_USERNAME=tu_usuario
UCURSOS_PASSWORD=tu_contraseña

# Portal de U-Cursos
UCURSOS_URL=https://www.u-cursos.cl

# Rutas de Chromium y su driver. Solo hacen falta si no estan en /usr/bin,
# por ejemplo si instalaste Chromium por snap:
# CHROMIUM_PATH=/snap/chromium/current/usr/lib/chromium-browser/chrome
# CHROMEDRIVER_PATH=/snap/bin/chromium.chromedriver
